# Copy to .env and fill in. Every value is public client config, not a secret.
# Vite only exposes variables that start with VITE_.

# --- Firebase web app config (Firebase console > Project settings > Your apps) ---
# Required. Without these the app runs in pattern-only mode and cannot use the cloud model.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- App Check (reCAPTCHA Enterprise) ---
# Optional. Site key from the reCAPTCHA Enterprise console. Leave empty to skip App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional. Local development only. Register this token in the Firebase console
# (App Check > Manage debug tokens). Leave empty to get a token printed in the console instead.
VITE_APPCHECK_DEBUG_TOKEN=

# --- Cloud model used for explanations ---
# Optional. Defaults to gemini-3.5-flash-lite.
VITE_CLOUD_MODEL=
